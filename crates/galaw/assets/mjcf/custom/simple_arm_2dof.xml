<mujoco model="simple_arm_2dof">
  <!--
    Two-DOF robot arm equivalent to assets/urdf/custom/simple_arm_2dof.urdf.
    Links:  base_link -> upper_arm -> forearm
    Joints: shoulder_joint (hinge, Z axis, at z=0.1 from base)
            elbow_joint    (hinge, Y axis, at z=0.9 from upper_arm)
  -->
  <compiler angle="radian" />

  <worldbody>
    <body name="base_link">
      <body name="upper_arm" pos="0 0 0.1">
        <joint name="shoulder_joint" type="hinge" axis="0 0 1"
               range="-1.57 1.57" />
        <body name="forearm" pos="0 0 0.9">
          <joint name="elbow_joint" type="hinge" axis="0 1 0"
                 range="-1.57 1.57" />
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
