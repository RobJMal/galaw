<mujoco model="simple_arm_2dof_flipped">
  <!--
    Same robot as simple_arm_2dof.xml but with the <joint> element declared
    *after* the child <body> element inside upper_arm. Guards against parsers
    that assume joints always precede child bodies within a <body> element.
  -->
  <compiler angle="radian" />

  <worldbody>
    <body name="base_link">
      <body name="upper_arm" pos="0 0 0.1">
        <!-- child body declared before joint — the flipped ordering -->
        <body name="forearm" pos="0 0 0.9">
          <joint name="elbow_joint" type="hinge" axis="0 1 0"
                 range="-1.57 1.57" />
        </body>
        <joint name="shoulder_joint" type="hinge" axis="0 0 1"
               range="-1.57 1.57" />
      </body>
    </body>
  </worldbody>
</mujoco>
